{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "awc-example-remote-executor",
  "main": "./src/index.ts",
  "compatibility_date": "2026-10-31",
  "workers_dev": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "awc-executor-example",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./migrations"
    }
  ],
  "vars": {
    "ENABLE_EXAMPLE_EXECUTOR": "false",
    "ENABLE_MODBUS_PCAP": "false",
    "ENABLE_TCP_FLOW": "false"
  }
}
